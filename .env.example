# ===== Front-end (Vite expoe apenas variaveis VITE_*) =====
VITE_META_PIXEL_ID=

# ===== IA / Sinopse (server-side) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Meta Conversions API / CAPI (server-side) =====
# Purchase oficial disparado pelo webhook do MP, com fbc/fbp e event_id
# igual ao do Pixel (deduplicacao). Sem os dois, o webhook so loga.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=<redacted>

# ===== Mercado Pago (server-side) =====
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ===== Painel do site (/dashboardfunil) e funil interno (server-side) =====
# Forma principal de entrar no painel: usuario + senha (so a Caroline sabe).
ADMIN_USER=
ADMIN_PASSWORD=
# Fallback (opcional): chave unica antiga do painel. Se ADMIN_USER/
# ADMIN_PASSWORD estiverem definidos, os dois jeitos funcionam.
ADMIN_KEY=
# URL publica do site em producao (sem barra no fim). Usada no aviso do
# Telegram para montar o link direto da foto da crianca no pedido pago
# (o link abre a foto via /api/admin-photo, que exige o login do painel
# no navegador). Sem ela, o aviso diz que a foto esta no painel.
PUBLIC_BASE_URL=
# TRACK_KV nao e uma variavel de texto: e o binding do Cloudflare KV
# (camada gratuita) conectado ao projeto na hora do deploy, com o nome
# TRACK_KV. Sem o binding, o servidor guarda os contadores do funil em
# arquivo local (dev) ou em memoria — o painel funciona do mesmo jeito.

# ===== Entrega fase 1 (semi-automatica) — use um dos dois =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DELIVERY_WEBHOOK_URL=
